<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@color/calc_bg"
    android:fitsSystemWindows="true">

    <!-- Zone d'affichage : occupe la majeure partie de l'écran, ancrée à droite (RTL) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.1"
        android:orientation="vertical"
        android:gravity="bottom|right"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp">

        <!-- Ligne 1 : opération en cours (ex : 12 +). Hauteur minimale fixe pour que
             la zone d'affichage garde toujours 2 lignes visibles, même vide. -->
        <HorizontalScrollView
            android:id="@+id/sv_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="false">

            <TextView
                android:id="@+id/tv_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:gravity="right"
                android:minHeight="30dp"
                android:maxLines="1"
                android:textColor="#99000000"
                android:textSize="24sp"
                android:fontFamily="@font/ayneha_pro"
                android:text="" />
        </HorizontalScrollView>

        <!-- Ligne 2 (miniature) : résultat de l'opération. Ne se met à jour qu'après "=".
             Reste en petite police, comme la ligne d'opération au-dessus. -->
        <HorizontalScrollView
            android:id="@+id/sv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="false">

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:gravity="right"
                android:minHeight="30dp"
                android:maxLines="1"
                android:textColor="#99000000"
                android:textSize="24sp"
                android:fontFamily="@font/ayneha_pro"
                android:text="" />
        </HorizontalScrollView>

        <!-- Ligne 3 (grande) : saisie en cours. Scrollable horizontalement au doigt,
             sans troncature par points de suspension. -->
        <HorizontalScrollView
            android:id="@+id/sv_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="false">

            <TextView
                android:id="@+id/tv_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:gravity="right"
                android:maxLines="1"
                android:textColor="@color/display_text"
                android:textSize="80sp"
                android:fontFamily="@font/ayneha_pro"
                android:text="@string/digit_0" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Clavier de la calculatrice -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <!-- Rangée 1 : AC, retour arrière, %, ÷ -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/btn_ac" style="@style/KeyBlue" android:text="AC" android:textSize="44sp" />
            <Button android:id="@+id/btn_back" style="@style/KeyBlue" android:text="⌫" android:textSize="52sp" android:scaleX="-1" />
            <Button android:id="@+id/btn_percent" style="@style/KeyBlue" android:text="%" android:textSize="52sp" />
            <Button android:id="@+id/btn_div" style="@style/KeyOrange" android:text="÷" android:textSize="60sp" />
        </LinearLayout>

        <!-- Rangée 2 : 7, 8, 9, × -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/btn_7" style="@style/KeyDigit" android:text="@string/digit_7" />
            <Button android:id="@+id/btn_8" style="@style/KeyDigit" android:text="@string/digit_8" />
            <Button android:id="@+id/btn_9" style="@style/KeyDigit" android:text="@string/digit_9" />
            <Button android:id="@+id/btn_mul" style="@style/KeyOrange" android:text="×" android:textSize="56sp" />
        </LinearLayout>

        <!-- Rangée 3 : 4, 5, 6, − -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/btn_4" style="@style/KeyDigit" android:text="@string/digit_4" />
            <Button android:id="@+id/btn_5" style="@style/KeyDigit" android:text="@string/digit_5" />
            <Button android:id="@+id/btn_6" style="@style/KeyDigit" android:text="@string/digit_6" />
            <Button android:id="@+id/btn_sub" style="@style/KeyOrange" android:text="−" android:textSize="56sp" />
        </LinearLayout>

        <!-- Rangée 4 : 1, 2, 3, + -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/btn_1" style="@style/KeyDigit" android:text="@string/digit_1" />
            <Button android:id="@+id/btn_2" style="@style/KeyDigit" android:text="@string/digit_2" />
            <Button android:id="@+id/btn_3" style="@style/KeyDigit" android:text="@string/digit_3" />
            <Button android:id="@+id/btn_add" style="@style/KeyOrange" android:text="+" android:textSize="56sp" />
        </LinearLayout>

        <!-- Rangée 5 : virgule (bas-droite), 0, = sur les deux dernières touches (bas-gauche) -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/btn_dot" style="@style/KeyBlueDigit" android:text="@string/ayneha_comma" />
            <Button android:id="@+id/btn_0" style="@style/KeyDigit" android:text="@string/digit_0" />
            <Button android:id="@+id/btn_eq" style="@style/KeyBlue" android:layout_weight="2" android:text="=" android:textSize="60sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

    <!-- Bouton Confidentialité : petit "i" discret, coin haut-gauche, hors du flux
         de la disposition RTL pour ne perturber ni les touches ni l'affichage. -->
    <TextView
        android:id="@+id/btn_info"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|left"
        android:layout_margin="14dp"
        android:background="@drawable/circle_info_bg"
        android:gravity="center"
        android:text="i"
        android:textStyle="italic|bold"
        android:textSize="18sp"
        android:textColor="@color/key_blue_dark"
        android:contentDescription="@string/info_button_desc"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
