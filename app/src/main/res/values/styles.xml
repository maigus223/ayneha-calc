<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="KeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="KeyBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="KeyBlack" parent="KeyBase">
        <item name="android:background">@drawable/key_bg_black</item>
        <item name="android:textColor">@color/key_text_on_black</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="KeyDigit" parent="KeyBase">
        <item name="android:background">@drawable/key_bg_black</item>
        <item name="android:textColor">@color/key_text_on_black</item>
        <item name="android:textSize">60sp</item>
        <item name="android:fontFamily">@font/ayneha_pro</item>
    </style>

    <!-- Touches fonctions : AC, Effacer, %, Décimal, Égal -->
    <style name="KeyBlue" parent="KeyBase">
        <item name="android:background">@drawable/key_bg_blue</item>
        <item name="android:textColor">@color/key_text_on_black</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Touche Décimal : même fond bleu, mais police AYNEHA pour la virgule -->
    <style name="KeyBlueDigit" parent="KeyBase">
        <item name="android:background">@drawable/key_bg_blue</item>
        <item name="android:textColor">@color/key_text_on_black</item>
        <item name="android:textSize">60sp</item>
        <item name="android:fontFamily">@font/ayneha_pro</item>
    </style>

    <!-- Touches opérateurs : +, −, ×, ÷ -->
    <style name="KeyOrange" parent="KeyBase">
        <item name="android:background">@drawable/key_bg_orange</item>
        <item name="android:textColor">@color/key_text_on_black</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
